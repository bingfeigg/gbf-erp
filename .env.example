# 复制为 .env 后按需修改；部署脚本可传入其它路径。
# bash: set -a && source .env && set +a && npm run start

# —— 本地开发常用 NODE_ENV=development（JWT 可为空）。
# —— 生产 NODE_ENV=production 时必须设置 JWT_SECRET（长度 ≥ 32，不可用占位串）。
NODE_ENV=development
PORT=3100

JWT_SECRET=

# 仅这些用户名可看到开发测试操作区（逗号分隔，大小写不敏感）。
# 例如：DEV_OPS_USERS=root,dev01
DEV_OPS_USERS=

# --- 可选：审批超时扫描默认参数（数据库中的规则表可覆盖）---
APPROVAL_OVERDUE_HOURS=24
APPROVAL_SCAN_INTERVAL_MS=300000
