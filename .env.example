# 复制为 .env 后按需修改；部署脚本可传入其它路径。
# bash: set -a && source .env && set +a && npm run start

# —— 本地开发常用 NODE_ENV=development（JWT 可为空）。
# —— 生产 NODE_ENV=production 时必须设置 JWT_SECRET（长度 ≥ 32，不可用占位串）。
NODE_ENV=development
PORT=3100

# 非生产环境：未带 Bearer 时是否允许用请求头 x-username 模拟用户。
# 未设置且 NODE_ENV=development 时默认为开启；设为 0/false 可关闭（仅 JWT）。
# 生产环境忽略此项，一律要求 JWT。
ALLOW_DEV_HEADER_AUTH=1

JWT_SECRET=

# --- 离线许可证（可选）：设置公钥后启用校验；未设置则不校验（兼容既有部署）。
# 签发给客户前用 npm run license:keys 生成密钥对；私钥仅用于签发方 npm run license:sign。
# LICENSE_PUBLIC_KEY_FILE=/path/to/license_public.pem
# LICENSE_FILE=（可选，默认 DATA_DIR/license.json）
# 交付场景建议设为 1：未配置公钥则进程拒绝启动（必须先部署验签公钥）。
# LICENSE_PUBLIC_KEY_REQUIRED=1
# 已配置公钥但尚未导入正式许可证时的试用天数（默认 7；计时起点见 data/trial.json）。
# LICENSE_TRIAL_DAYS=7

# 仅这些用户名可看到开发测试操作区（逗号分隔，大小写不敏感）。
# 例如：DEV_OPS_USERS=root,dev01
DEV_OPS_USERS=

# --- 可选：审批超时扫描默认参数（数据库中的规则表可覆盖）---
APPROVAL_OVERDUE_HOURS=24
APPROVAL_SCAN_INTERVAL_MS=300000
