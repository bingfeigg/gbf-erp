# 复制为 .env 后按需修改；部署脚本可传入其它 env 文件路径。
# bash: set -a && source .env && set +a && npm run start

NODE_ENV=development
PORT=3100

# 生产环境（NODE_ENV=production）下必须设置，且长度 >= 32，不能使用默认值。
# 生成示例：openssl rand -hex 32
JWT_SECRET=

# 仅这些用户名可看到开发测试操作区（逗号分隔，大小写不敏感）。
# 例如：DEV_OPS_USERS=root,dev01,rd_zhangsan,qa_lisi
DEV_OPS_USERS=
